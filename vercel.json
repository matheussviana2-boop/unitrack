{
  "version": 2,
  "routes": [
    { "src": "/api/posicao", "dest": "/api/posicao.js" },
    { "src": "/api/viagens", "dest": "/api/viagens.js" },
    {
      "src": "/sw.js",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate", "Service-Worker-Allowed": "/" },
      "dest": "/sw.js"
    },
    {
      "src": "/manifest.json",
      "headers": { "Content-Type": "application/manifest+json", "Cache-Control": "no-cache, no-store, must-revalidate" },
      "dest": "/manifest.json"
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
